{
  "name": "@j_shelfwood/talos-ui",
  "version": "0.5.1",
  "description": "Dark-monochrome HUD design system — chamfered panels, Oxanium type, ambient grid, and composable notched-panel web components. Framework-agnostic CSS + opt-in web components + Astro wrappers.",
  "license": "MIT",
  "author": "Joris Schelfhout <joris@shelfwood.co>",
  "homepage": "https://talos-ui.shelfwood.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-shelfwood/talos-ui.git"
  },
  "keywords": [
    "design-system",
    "hud",
    "web-components",
    "astro",
    "css",
    "monochrome",
    "chamfer",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/wc/index.js",
    "./dist/wc/talos-compass.js",
    "./dist/wc/talos-corner.js",
    "./dist/wc/talos-delta.js",
    "./dist/wc/talos-dots.js",
    "./dist/wc/talos-flow.js",
    "./dist/wc/talos-gauge.js",
    "./dist/wc/talos-groundtrack.js",
    "./dist/wc/talos-histogram.js",
    "./dist/wc/talos-led.js",
    "./dist/wc/talos-matrix.js",
    "./dist/wc/talos-meter.js",
    "./dist/wc/talos-notch.js",
    "./dist/wc/talos-odometer.js",
    "./dist/wc/talos-orbital.js",
    "./dist/wc/talos-panel.js",
    "./dist/wc/talos-percentile.js",
    "./dist/wc/talos-plane.js",
    "./dist/wc/talos-range.js",
    "./dist/wc/talos-readout.js",
    "./dist/wc/talos-sheen.js",
    "./dist/wc/talos-spacecraft.js",
    "./dist/wc/talos-spark.js",
    "./dist/wc/talos-stat.js",
    "./dist/wc/talos-status.js",
    "./dist/wc/talos-ticker.js",
    "./dist/wc/talos-toggle.js",
    "./dist/wc/talos-trend.js"
  ],
  "files": [
    "dist",
    "src/all.css",
    "src/tokens.css",
    "src/talos.css",
    "src/talos-layout.css",
    "src/talos-forms.css",
    "src/talos-feedback.css",
    "src/talos-data.css",
    "src/talos-nav.css",
    "src/talos-console.css",
    "src/talos-marketing.css",
    "src/talos-motion.css",
    "src/talos-prose.css",
    "src/fonts",
    "src/astro",
    "src/brand",
    "DESIGN.md",
    "PHILOSOPHY.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/wc/index.d.ts",
      "import": "./dist/wc/index.js"
    },
    "./all.css": "./src/all.css",
    "./tokens.css": "./src/tokens.css",
    "./talos.css": "./src/talos.css",
    "./talos-layout.css": "./src/talos-layout.css",
    "./talos-forms.css": "./src/talos-forms.css",
    "./talos-feedback.css": "./src/talos-feedback.css",
    "./talos-data.css": "./src/talos-data.css",
    "./talos-nav.css": "./src/talos-nav.css",
    "./talos-console.css": "./src/talos-console.css",
    "./talos-marketing.css": "./src/talos-marketing.css",
    "./talos-motion.css": "./src/talos-motion.css",
    "./talos-prose.css": "./src/talos-prose.css",
    "./wc": {
      "types": "./dist/wc/index.d.ts",
      "import": "./dist/wc/index.js"
    },
    "./wc/*": {
      "types": "./dist/wc/*.d.ts",
      "import": "./dist/wc/*.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts",
      "import": "./dist/ambient.js"
    },
    "./astro/*": "./src/astro/*",
    "./brand/*": "./src/brand/*",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "astro": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

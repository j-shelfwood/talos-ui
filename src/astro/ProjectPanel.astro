---
/**
 * ProjectPanel — project link card: optional media banner (screenshot),
 * header (title + directional corner glyph), muted description, and a tag row.
 * Renders as an anchor when `href` is set so the GlassPanel HUD brackets light
 * up on hover. De-Tailwinded.
 * Requires "@j_shelfwood/talos-ui/talos.css" + "/talos-feedback.css" (tag badges).
 *
 * The corner glyph stays consumer-side via the `arrow` slot (no icon dep); it
 * falls back to a unicode glyph ("↗" external / "→" internal) so the component
 * works with no slot.
 *
 * The `media` slot renders an inset "display" between the header and the
 * description — pass an <img>. The shot sits inside the panel padding in a
 * hairline frame (never bleeding into the chamfer/bracket furniture), is
 * darkened toward the panel tone so it reads as a dim feed rather than a
 * photo, carries a FEED:// label derived from `href` (override via
 * `mediaLabel`), and lifts its tint on hover.
 */
import GlassPanel from "./GlassPanel.astro";

interface Props {
  title: string;
  description: string;
  tags?: string[];
  href?: string;
  external?: boolean;
  /** Label on the media feed strip; defaults to FEED://<hostname of href>. */
  mediaLabel?: string;
  class?: string;
}
const {
  title,
  description,
  tags = [],
  href,
  external = false,
  mediaLabel,
  class: className,
} = Astro.props;

const feedLabel =
  mediaLabel ??
  (() => {
    try {
      return href ? `FEED://${new URL(href, "https://x").hostname}` : "FEED://";
    } catch {
      return "FEED://";
    }
  })();

const glyph = external ? "↗" : "→"; // ↗ external / → internal
const linkProps = href
  ? { as: "a" as const, href, ...(external ? { target: "_blank", rel: "noreferrer noopener" } : {}) }
  : {};

const hasArrow = Astro.slots.has("arrow");
const hasMedia = Astro.slots.has("media");
---

<GlassPanel
  class={["project-card", "talos-pad", className].filter(Boolean).join(" ")}
  {...linkProps}
>
  <div class="project-card__head">
    <h3 class="project-card__title">{title}</h3>
    <span class="project-card__glyph" aria-hidden="true">
      {hasArrow ? <slot name="arrow" /> : glyph}
    </span>
  </div>

  {hasMedia && (
    <div class="project-card__media">
      <slot name="media" />
      <span class="project-card__media-tint" aria-hidden="true" />
      <span class="project-card__media-label" aria-hidden="true">{feedLabel}</span>
    </div>
  )}

  <p class="project-card__desc">{description}</p>

  {tags.length > 0 && (
    <div class="project-card__tags">
      {tags.map((tag) => <span class="talos-badge talos-badge--sm">{tag}</span>)}
    </div>
  )}
</GlassPanel>

<style>
  .project-card { display: flex; flex-direction: column; }
  /* GlassPanel interposes .glass-panel-content; stretch it so the media strip
     can absorb surplus height in tall (row-span) cards. */
  .project-card > :global(.glass-panel-content) { flex: 1; }

  /* --- media display -------------------------------------------------------- */
  /* Inset "screen" between header and description: sits INSIDE the panel
     padding so the GlassPanel chamfer and hover brackets keep their normal
     geometry. Hairline frame; the shot is pulled DOWN to the panel's tonal
     range (dark tint + desaturation) so it reads as instrumentation, not
     photography; hover lifts the tint without ever going full-bright. */
  .project-card__media {
    position: relative;
    /* Fixed native aspect so the shot is never cropped — growth would make
       cover-cropping vary per card. Surplus height in stretched cards goes
       to the description gap (tags stay bottom-anchored). */
    flex: 0 0 auto;
    aspect-ratio: 16 / 10;
    margin: 0 0 1.25rem;
    overflow: hidden;
    border: 1px solid hsl(0 0% 100% / 0.12);
  }
  .project-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) brightness(0.9) contrast(0.95);
    transition: filter var(--talos-dur-med, 300ms) var(--talos-ease-out, ease);
  }
  /* Heavy tint pulls light websites into the HUD's dark register. */
  .project-card__media-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, hsl(0 0% 4% / 0.45) 0%, hsl(0 0% 4% / 0.72) 100%);
    transition: opacity var(--talos-dur-med, 300ms) var(--talos-ease-out, ease);
  }
  .project-card:hover .project-card__media {
    border-color: hsl(0 0% 100% / 0.25);
  }
  .project-card:hover .project-card__media :global(img) {
    filter: grayscale(0.15) brightness(0.95) contrast(1);
  }
  .project-card:hover .project-card__media-tint { opacity: 0.45; }
  /* FEED:// designation, bottom-left inside the frame. */
  .project-card__media-label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.5rem;
    font-family: var(--talos-font-display);
    font-size: 0.6rem;
    letter-spacing: var(--talos-tracking-hud);
    text-transform: uppercase;
    color: hsl(0 0% 100% / 0.55);
    text-shadow: 0 1px 2px hsl(0 0% 0% / 0.8);
  }

  .project-card__head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 1rem; margin-bottom: 0.75rem;
  }
  .project-card__title {
    font-family: var(--talos-font-display); font-weight: 400; font-size: 0.88rem;
    text-transform: uppercase; letter-spacing: var(--talos-tracking-hud-tight);
    color: var(--talos-foreground); margin: 0;
  }
  .project-card__glyph {
    flex: 0 0 auto; font-family: var(--talos-font-display); font-size: 0.95rem;
    line-height: 1; color: hsl(0 0% 100% / 0.5);
    transition: transform var(--talos-dur-fast) var(--talos-ease-out),
      color var(--talos-dur-fast) var(--talos-ease-out);
  }
  .project-card:hover .project-card__glyph {
    color: hsl(0 0% 100%); transform: translate(0.15rem, -0.15rem);
  }
  .project-card__desc {
    font-size: 0.85rem; line-height: 1.6; color: var(--talos-muted-foreground);
    margin: 0 0 1.25rem; flex: 1; text-wrap: pretty;
  }
  .project-card__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; }
</style>

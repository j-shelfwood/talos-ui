---
/**
 * Button — chamfered HUD CTA. Renders <a> when href is set, else <button>.
 * Requires "@j_shelfwood/talos-ui/talos.css".
 */
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "solid";
  size?: "xs" | "sm" | "md" | "lg";
  href?: string;
  class?: string;
  [key: string]: any;
}

const { variant = "primary", size = "md", href, class: className, ...rest } =
  Astro.props;
const Element = href ? "a" : "button";
const cls = [
  "talos-button",
  variant !== "primary" && `talos-button--${variant}`,
  size !== "md" && `talos-button--${size}`,
  className,
]
  .filter(Boolean)
  .join(" ");
const elementProps = href ? { href, ...rest } : rest;

// The cut is drawn by the chamfer engine in talos.css (clip-path + a 1px
// diagonal), so the element needs no SVG child and the cut stays exactly 10px
// at any width.
---

<Element class={cls} {...elementProps}>
  <span class="talos-button__label"><slot /></span>
</Element>

---
/**
 * Footer — three-column marketing footer (links · brand · contact) over a
 * GlassPanel, with a hairline copyright rule.
 *
 * Opt-in marketing chrome — requires `@j_shelfwood/talos-ui/talos-marketing.css`
 * (or all.css) plus talos.css for the GlassPanel.
 *
 * Icons stay consumer-side (the package adds no icon dependency). The links
 * column is text-only from the `nav` prop by default; to put an icon beside
 * each link, render the whole column yourself via the `links` slot (Astro
 * requires static slot names, so the package can't emit one slot per dynamic
 * nav key). The contact rows accept per-row `icon-email` / `icon-phone` /
 * `icon-location` / `icon-calendar` slots.
 *
 * @example
 *   <Footer
 *     nav={[{ key: "work", title: "Work", href: "/work" }]}
 *     contact={{ email: "you@site.co", phone: "+31 6 …", location: "NL" }}
 *     calendarUrl="https://cal.com/you"
 *     copyright="Shelfwood.co"
 *   >
 *     <Fragment slot="links">
 *       <a class="talos-footer-link" href="/work">
 *         <Icon name="lucide:folder" /><span class="talos-nav-text">Work</span>
 *       </a>
 *     </Fragment>
 *     <Icon slot="icon-email" name="lucide:mail" />
 *   </Footer>
 */
import GlassPanel from "./GlassPanel.astro";
import BrandMark from "./BrandMark.astro";

export interface FooterNavLink {
  key: string;
  title: string;
  href: string;
}
export interface FooterContact {
  email?: string;
  phone?: string;
  location?: string;
}

interface Props {
  nav?: FooterNavLink[];
  contact?: FooterContact;
  /** "Book a consultation" link target; omit to hide the row. */
  calendarUrl?: string;
  /** Heading above the contact column. */
  contactHeading?: string;
  /** Entity name in the copyright line. */
  copyright?: string;
  /** Tagline after the copyright separator. */
  tagline?: string;
  /** Home link the brand points at. */
  homeHref?: string;
  class?: string;
  [key: string]: any;
}

const {
  nav = [],
  contact = {},
  calendarUrl,
  contactHeading = "Get in touch",
  copyright,
  tagline = "All systems nominal",
  homeHref = "/",
  class: className,
  ...rest
} = Astro.props;

const year = new Date().getFullYear();
const hasBrandSlot = Astro.slots.has("brand");
// When the consumer needs per-link icons, it renders the whole nav column via
// the `links` slot (Astro requires static slot names, so the package can't emit
// one icon slot per dynamic key). Otherwise the `nav` prop renders text links.
const hasLinksSlot = Astro.slots.has("links");
---

<footer class:list={["talos-footer", className]} {...rest}>
  <GlassPanel class="talos-footer-panel" style="padding:2rem">
    <div class="talos-footer-grid">
      <div class="talos-footer-col--links">
        {hasLinksSlot ? (
          <slot name="links" />
        ) : (
          nav.map((link) => (
            <a class="talos-footer-link" href={link.href}>
              <span class="talos-nav-text">{link.title}</span>
            </a>
          ))
        )}
      </div>

      <div class="talos-footer-col--brand">
        <a href={homeHref} aria-label="Home">
          {hasBrandSlot ? <slot name="brand" /> : <BrandMark />}
        </a>
      </div>

      <div class="talos-footer-col--contact">
        {contactHeading && <h3 class="talos-footer-heading">{contactHeading}</h3>}
        <div class="talos-footer-contact">
          {contact.email && (
            <a href={`mailto:${contact.email}`}>
              <span class="talos-nav-text">{contact.email}</span>
              <slot name="icon-email" />
            </a>
          )}
          {contact.phone && (
            <a href={`tel:${contact.phone}`}>
              <span class="talos-nav-text">{contact.phone}</span>
              <slot name="icon-phone" />
            </a>
          )}
          {contact.location && (
            <span>
              <span class="talos-nav-text">{contact.location}</span>
              <slot name="icon-location" />
            </span>
          )}
          {calendarUrl && (
            <a href={calendarUrl} target="_blank" rel="noopener noreferrer">
              <span class="talos-nav-text">Book a consultation</span>
              <slot name="icon-calendar" />
            </a>
          )}
        </div>
      </div>
    </div>

    <p class="talos-footer-copy">
      &copy; {year}{copyright ? ` ${copyright}` : ""}
      {tagline && (
        <>
          <span class="talos-footer-copy-sep">/</span>{tagline}
        </>
      )}
    </p>
  </GlassPanel>
</footer>
